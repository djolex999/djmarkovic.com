---
import { site } from "../config/site";

interface Props {
  /** The name is the page's h1 everywhere except pages with their own title, like posts. */
  nameAs?: "h1" | "p";
}

const { nameAs: NameTag = "h1" } = Astro.props;

interface NavLink {
  label: string;
  href: string;
  external: boolean;
}

const nav: NavLink[] = [
  { label: "email", href: `mailto:${site.contact.email}`, external: false },
  { label: "github", href: site.contact.github, external: true },
  { label: "linkedin", href: site.contact.linkedin, external: true },
];

if (site.cv !== null) {
  nav.push({ label: "cv", href: site.cv, external: false });
}
---

<header class="site-header">
  <NameTag class="name"><a href="/">{site.name}</a></NameTag>
  <p class="role">
    {site.role} <span class="muted">· {site.location}</span>
  </p>
  <nav aria-label="Contact">
    <ul class="list-plain nav">
      {
        nav.map((link) => (
          <li>
            <a href={link.href}>{link.external ? `${link.label} ↗` : link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .name {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .name a {
    text-decoration: none;
  }

  .role {
    margin: 6px 0 0;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .nav a {
    display: inline-block;
    padding: 4px 0;
  }
</style>
