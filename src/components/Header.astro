---
import { site } from "../config/site";

interface Props {
  /** The name is the page's h1 everywhere except pages with their own title, like posts. */
  nameAs?: "h1" | "p";
}

const { nameAs: NameTag = "h1" } = Astro.props;

type NavItem =
  | { kind: "link"; label: string; href: string; external: boolean }
  | { kind: "reveal"; label: string; value: string };

const nav: NavItem[] = [
  { kind: "link", label: "writing", href: "/writing", external: false },
  { kind: "reveal", label: "email", value: site.contact.email },
  { kind: "link", label: "github", href: site.contact.github, external: true },
  { kind: "link", label: "linkedin", href: site.contact.linkedin, external: true },
];

if (site.cv !== null) {
  nav.push({ kind: "link", label: "cv", href: site.cv, external: false });
}

const currentPath = Astro.url.pathname.replace(/\.html$/, "");
---

<header class="site-header">
  <NameTag class="name"><a href="/">{site.name}</a></NameTag>
  <p class="role">
    {site.role} <span class="muted">· {site.location}</span>
  </p>
  <nav aria-label="Main">
    <ul class="list-plain nav">
      {
        nav.map((item) => (
          <li>
            {item.kind === "reveal" ? (
              <details class="reveal">
                <summary>{item.label}</summary>
                <span class="revealed">{item.value}</span>
              </details>
            ) : (
              <a href={item.href} aria-current={item.href === currentPath ? "page" : undefined}>
                {item.external ? `${item.label} ↗` : item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .name {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .name a {
    text-decoration: none;
  }

  .role {
    margin: 6px 0 0;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .nav a {
    display: inline-block;
    padding: 4px 0;
  }

  .nav a[aria-current="page"] {
    text-decoration-thickness: 2px;
  }

  /* email: a no-JS reveal instead of a mailto: link */
  .reveal {
    display: inline;
  }

  /* Lets the address sit inline next to the summary. display: contents drops
     the box the browser hides closed content with, so hide it explicitly. */
  .reveal::details-content {
    display: contents;
  }

  .reveal:not([open]) .revealed {
    display: none;
  }

  .reveal summary {
    display: inline-block;
    padding: 4px 0;
    list-style: none;
    cursor: pointer;
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .reveal summary::-webkit-details-marker {
    display: none;
  }

  .reveal summary::marker {
    content: "";
  }

  .reveal summary:hover,
  .reveal[open] summary {
    text-decoration-thickness: 2px;
  }

  .revealed {
    margin-left: 10px;
    white-space: nowrap;
    user-select: all;
    -webkit-user-select: all;
  }
</style>
