---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import PostList from "../components/PostList.astro";
import { featuredProjects, smallProjects } from "../data/projects";
import { getPosts } from "../lib/writing";

const latestPosts = (await getPosts()).slice(0, 3);
---

<Base>
  <Header slot="header" />

  <section class="section" aria-labelledby="about">
    <h2 id="about" class="section-title">about</h2>
    <p>
      I build web and AI products in TypeScript and Python, and I use AI coding agents every day.
      Writing code got cheap, so my effort goes into checking it: I read every diff, keep tests and
      automated checks around the agent, and choose models with my own evals. That's how I run
      pripremi.rs, and how I built Fulcrum, 2nd place at Adapty's First Commit hackathon. On the side
      I run GrowthQ Lab, a small studio I co-founded, so I think about what a feature costs and who
      it's for, not only how to build it. I have a BSc in Computer Science and I'm looking for
      full-stack or AI engineering roles in Serbia or remote.
    </p>
  </section>

  <section class="section" aria-labelledby="work">
    <h2 id="work" class="section-title">selected work</h2>
    <div>
      {featuredProjects.map((project) => <ProjectEntry project={project} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="also">
    <h2 id="also" class="section-title">also built</h2>
    <ul class="list-plain small">
      {
        smallProjects.map((project) => (
          <li class="small-item">
            <span class="small-name">
              {project.href ? (
                <a href={project.href}>
                  <strong>{project.name}</strong> ↗
                </a>
              ) : (
                <strong>{project.name}</strong>
              )}
            </span>
            <span class={`status status-${project.status}`}>{project.status}</span>{" "}
            <span>
              {project.summary} <span class="stack">{project.stack.join(" · ")}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="section" aria-labelledby="writing">
        <h2 id="writing" class="section-title">
          writing
        </h2>
        <PostList posts={latestPosts} />
        <p class="all-writing">
          <a href="/writing">all writing</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .small li + li {
    margin-top: 12px;
  }

  .small-name::after {
    content: ":";
  }

  .status {
    float: right;
    margin-left: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: calc(17px * 1.6);
  }

  .status-shipped {
    color: var(--muted);
  }

  .status-experiment,
  .status-research {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .small-item {
      display: flex;
      flex-direction: column;
    }

    .small-name::after {
      content: none;
    }

    .status {
      float: none;
      margin: 0 0 2px;
      line-height: 1.6;
    }
  }

  .all-writing {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
</style>
